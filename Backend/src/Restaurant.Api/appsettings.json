{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/restaurant-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },

  "AllowedHosts": "*",

  "Reservations": {
    "DurationMinutes": 120,
    "OpeningHour": 10,
    "ClosingHour": 23,
    "MaxDaysAhead": 30,
    "MinCancelHoursBefore": 2,
    "ReservedSoonMinutes": 30,
    "NoShowAfterMinutes": 15
  },
  "PinProtection": {
    "MaxFailedAttempts": 5,
    "BlockMinutes": 5
  }
}
